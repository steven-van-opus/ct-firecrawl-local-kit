# Client examples and the external firecrawl-mcp process use this base URL.
FIRECRAWL_API_URL=http://127.0.0.1:3002
# Empty for the default loopback Firecrawl Local server.
FIRECRAWL_API_KEY=
# Set this in the shell that launches firecrawl-local serve too.
FIRECRAWL_CLOUD=off
CT_REQUEST_TIMEOUT_MS=60000
